# API Security Configuration
# IMPORTANT: API_SECRET_KEY and NEXT_PUBLIC_API_KEY must match
# These are used for basic API validation
API_SECRET_KEY=your-secret-api-key-here
NEXT_PUBLIC_API_KEY=your-secret-api-key-here

# Firebase Client SDK Configuration
# Get these from Firebase Console -> Project Settings -> General -> Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Firebase Admin SDK Configuration
# Generate a new private key from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Private key should include newlines as \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"

# CORS Configuration
# Comma-separated list of allowed origins. Use * for all (not recommended for production).
ALLOWED_ORIGINS=http://localhost:3000

# Rate Limiting
# Maximum number of requests per window
RATE_LIMIT_MAX_REQUESTS=100

# API Protection
# Comma-separated paths that require API key authentication
PROTECTED_PATHS=/api

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# --- ADMIN ROLE SETUP ---
# To access the dashboard, a user must have the "admin" role set in their 
# Firebase Custom Claims. You can set this using the Firebase Admin SDK:
#
# admin.auth().setCustomUserClaims(uid, { role: 'admin' });
#
# Or use the provided script (if available):
# npm run set-admin -- email@example.com
# ------------------------
