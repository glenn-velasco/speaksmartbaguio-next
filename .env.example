# ==========================================
# Speak Smart Baguio API - Environment Variables
# ==========================================
# Copy this file to .env.local and fill in the values

# ==========================================
# Firebase Admin (Server-side - KEEP SECRET)
# ==========================================
# Get these from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"

# ==========================================
# Firebase Client (Client-side - Safe to expose)
# ==========================================
# Get these from Firebase Console > Project Settings > General > Your apps > Config
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ==========================================
# API Security
# ==========================================
# Generate a strong random key: openssl rand -base64 32
API_SECRET_KEY=your-secret-api-key-here

# ==========================================
# CORS Configuration
# ==========================================
# Comma-separated list of allowed origins (use * for development only)
# Production: https://yourdomain.com,https://anotherdomain.com
ALLOWED_ORIGINS=*

# ==========================================
# Rate Limiting
# ==========================================
# Maximum requests per IP per minute (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# Protected Paths (comma-separated)
# ==========================================
# Paths that require API key authentication
PROTECTED_PATHS=/api

# ==========================================
# Logging
# ==========================================
# Minimum log level: debug | info | warn | error
LOG_LEVEL=info

# ==========================================
# Node Environment
# ==========================================
NODE_ENV=development
