# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
NEXT_PUBLIC_FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"

# API Security
API_SECRET_KEY=your_api_secret_key_for_external_access
NEXT_PUBLIC_API_KEY=your_client_api_key_fallback

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100

# Protected API Paths
PROTECTED_PATHS=/api

# Log Level (debug, info, warn, error)
LOG_LEVEL=info

# IDrive E2 S3 Configuration
S3_ACCESS_KEY_ID=your_idrive_e2_access_key
S3_ACCESS_KEY_SECRET=your_idrive_e2_secret_key
S3_BUCKET_NAME=your_bucket_name
S3_REGION=your_region # e.g., us-east-1
S3_ENDPOINT=https://your_endpoint.idrivee2-xx.com # Custom IDrive E2 endpoint
S3_CDN_URL=https://your_cdn_url.idrivee2-xx.com # Optional: CDN URL for serving files

# Dropbox Configuration
# Create a Dropbox app at https://www.dropbox.com/developers/apps
# Enable "files.content.write" and "files.content.read" permissions
# Generate a refresh token using OAuth2 flow
DROPBOX_APP_KEY=your_dropbox_app_key
DROPBOX_APP_SECRET=your_dropbox_app_secret
DROPBOX_REFRESH_TOKEN=your_dropbox_refresh_token

# Storage Settings
MAX_AUDIO_FILE_SIZE_MB=50
ALLOWED_AUDIO_FORMATS=mp3,wav,ogg,m4a,flac
AUDIO_UPLOAD_EXPIRY_SECONDS=3600 # Presigned URL expiry time (1 hour)

# Storage Backend Preference (s3, dropbox, firebase, auto)
# - s3: Use S3 (IDrive E2) only
# - dropbox: Use Dropbox only
# - firebase: Use Firebase Storage only
# - auto: Try S3 first, then Dropbox, then Firebase
STORAGE_BACKEND=auto
